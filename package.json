{
  "name": "obsidian-music-pc",
  "productName": "Sonara",
  "version": "2.3.0",
  "description": "Sonara — a YouTube Music desktop player in Apple's Liquid Glass design",
  "main": "out/main/index.js",
  "author": "Alby Mathew Biju",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win-arm64": "electron-vite build && electron-builder --win --arm64",
    "dist:win-x64": "electron-vite build && electron-builder --win --x64",
    "dist:win": "electron-vite build && electron-builder --win --arm64 --x64",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --x64",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --arm64"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uimaxbai/am-lyrics": "^1.8.8",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "music-metadata": "^12.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.0.16"
  },
  "homepage": "https://github.com/Cyberspidey617/Sonara-Music",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyberspidey617/Sonara-Music.git"
  }
